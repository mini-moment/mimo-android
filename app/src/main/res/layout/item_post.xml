<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="post"
            type="com.mimo.android.domain.model.PostData" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/black">

        <androidx.cardview.widget.CardView
            android:id="@+id/card_view_videodetail_user_image"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginStart="15dp"
            android:layout_marginTop="15dp"
            app:cardCornerRadius="100dp"
            android:backgroundTint="@color/black">

            <ImageView
                android:id="@+id/iv_videodetail_user_image"
                android:layout_width="40dp"
                android:layout_height="40dp"
                tools:src="@drawable/videodetail_profile" />

        </androidx.cardview.widget.CardView>

        <TextView
            android:id="@+id/tv_videodetail_username"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@{post.userId}"
            android:textSize="24sp"
            android:textColor="@color/white"
            android:fontFamily="@font/pretendard_semi_bold"
            android:layout_marginStart="5dp"
            app:layout_constraintTop_toTopOf="@id/card_view_videodetail_user_image"
            app:layout_constraintLeft_toRightOf="@id/card_view_videodetail_user_image"
            app:layout_constraintBottom_toBottomOf="@id/card_view_videodetail_user_image"
            tools:text="username"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/gray"
            android:fontFamily="@font/pretendard_regular"
            android:layout_marginStart="5dp"
            app:elapsed_time=""
            app:layout_constraintTop_toTopOf="@id/tv_videodetail_username"
            app:layout_constraintStart_toEndOf="@id/tv_videodetail_username"
            app:layout_constraintBottom_toBottomOf="@id/tv_videodetail_username"
            tools:text="10min"/>

        <androidx.media3.ui.PlayerView
            android:id="@+id/player_view_videodetail_post_video"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/card_view_videodetail_user_image" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
